{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqec:vision:ai:deployment:1",
  "title": "VQEC Vision AI multi-source deployment configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "revision",
    "model_catalog_ref",
    "max_total_resident_bytes",
    "max_model_resident_bytes",
    "sources"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1 },
    "model_catalog_ref": { "$ref": "#/$defs/identifier" },
    "max_total_resident_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "max_model_resident_bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "raw_source_ref",
        "camera_id",
        "channel_id",
        "preview_output_ref",
        "width",
        "height",
        "fps_numerator",
        "fps_denominator",
        "max_frame_allocation_bytes",
        "max_inflight_frames",
        "preview_surface_count",
        "max_tensor_bytes",
        "max_temporal_bytes",
        "model_ids"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/identifier" },
        "raw_source_ref": { "$ref": "#/$defs/identifier" },
        "camera_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "channel_id": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "preview_output_ref": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^$|^[A-Za-z0-9_.:-]+$"
        },
        "width": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192,
          "multipleOf": 2
        },
        "height": {
          "type": "integer",
          "minimum": 2,
          "maximum": 8192,
          "multipleOf": 2
        },
        "fps_numerator": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "fps_denominator": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "max_frame_allocation_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 268435456
        },
        "max_inflight_frames": { "type": "integer", "minimum": 1, "maximum": 4 },
        "preview_surface_count": { "type": "integer", "minimum": 0, "maximum": 4 },
        "max_tensor_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_temporal_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "model_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/identifier" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "preview_surface_count": { "minimum": 1 } } },
          "then": { "properties": { "preview_output_ref": { "$ref": "#/$defs/identifier" } } },
          "else": { "properties": { "preview_output_ref": { "const": "" } } }
        }
      ]
    }
  }
}
