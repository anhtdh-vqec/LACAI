{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vqec:vision:ai:feature-catalog:1",
  "title": "VQEC Vision AI feature integration catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "catalog_id", "model_catalog_ref", "features"],
  "properties": {
    "schema_version": { "const": 1 },
    "revision": { "type": "integer", "minimum": 1, "maximum": 18446744073709551614 },
    "catalog_id": { "$ref": "#/$defs/identifier" },
    "model_catalog_ref": { "$ref": "#/$defs/identifier" },
    "features": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/$defs/feature" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "model_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role_id", "model_id"],
      "properties": {
        "role_id": { "$ref": "#/$defs/identifier" },
        "model_id": { "$ref": "#/$defs/identifier" }
      }
    },
    "attribute_dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "schema_version", "max_age_ns"],
      "properties": {
        "schema_id": { "$ref": "#/$defs/identifier" },
        "schema_version": { "$ref": "#/$defs/identifier" },
        "max_age_ns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551614
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_temporal_bytes_per_source",
        "max_events_per_update",
        "max_track_references_per_event",
        "max_fields_per_event"
      ],
      "properties": {
        "max_temporal_bytes_per_source": {
          "type": "integer",
          "minimum": 0,
          "maximum": 268435456
        },
        "max_events_per_update": { "type": "integer", "minimum": 1, "maximum": 64 },
        "max_track_references_per_event": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "max_fields_per_event": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_id",
        "feature_version",
        "processor_contract",
        "configuration_schema",
        "input_mode",
        "model_dependencies",
        "attribute_dependencies",
        "resources"
      ],
      "properties": {
        "feature_id": { "$ref": "#/$defs/identifier" },
        "feature_version": { "$ref": "#/$defs/identifier" },
        "processor_contract": { "$ref": "#/$defs/identifier" },
        "configuration_schema": { "$ref": "#/$defs/identifier" },
        "input_mode": { "enum": ["single_model", "temporal_join"] },
        "model_dependencies": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/model_dependency" }
        },
        "attribute_dependencies": {
          "type": "array",
          "maxItems": 32,
          "items": { "$ref": "#/$defs/attribute_dependency" }
        },
        "resources": { "$ref": "#/$defs/resources" }
      },
      "allOf": [
        {
          "if": { "properties": { "input_mode": { "const": "single_model" } } },
          "then": { "properties": { "model_dependencies": { "maxItems": 1 } } },
          "else": { "properties": { "model_dependencies": { "minItems": 2 } } }
        }
      ]
    }
  }
}
