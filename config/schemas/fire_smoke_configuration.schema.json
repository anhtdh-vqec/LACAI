{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vqec.local/schemas/fire_smoke_configuration.schema.json",
  "title": "Fire and smoke application configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classes", "temporal", "spatial", "incident", "severity", "evidence", "metadata"],
  "properties": {
    "schema_version": {"const": 1},
    "classes": {
      "type": "object", "additionalProperties": false,
      "required": ["fire_enabled", "smoke_enabled", "fire_alarm_confidence", "smoke_alarm_confidence", "minimum_region_area_ratio"],
      "properties": {
        "fire_enabled": {"type": "boolean"},
        "smoke_enabled": {"type": "boolean"},
        "fire_alarm_confidence": {"type": "number", "minimum": 0.25, "maximum": 1.0},
        "smoke_alarm_confidence": {"type": "number", "minimum": 0.25, "maximum": 1.0},
        "minimum_region_area_ratio": {"type": "number", "minimum": 0.0001, "maximum": 1.0}
      }
    },
    "temporal": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmation_count", "confirmation_duration_ms", "clear_count", "clear_duration_ms", "update_interval_ms"],
      "properties": {
        "confirmation_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "confirmation_duration_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
        "clear_count": {"type": "integer", "minimum": 1, "maximum": 300},
        "clear_duration_ms": {"type": "integer", "minimum": 0, "maximum": 300000},
        "update_interval_ms": {"type": "integer", "minimum": 100, "maximum": 60000}
      }
    },
    "spatial": {
      "type": "object", "additionalProperties": false,
      "required": ["scene_revision", "association_iou", "include_zone_ids", "exclude_zone_ids"],
      "properties": {
        "scene_revision": {"type": "integer", "minimum": 1},
        "association_iou": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "include_zone_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "exclude_zone_ids": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "incident": {
      "type": "object", "additionalProperties": false,
      "required": ["max_active_incidents", "source_gap_policy", "config_change_policy"],
      "properties": {
        "max_active_incidents": {"type": "integer", "minimum": 1, "maximum": 64},
        "source_gap_policy": {"enum": ["retain", "interrupt"]},
        "config_change_policy": {"const": "interrupt"}
      }
    },
    "severity": {
      "type": "object", "additionalProperties": false,
      "required": ["high_confidence", "critical_duration_ms"],
      "properties": {
        "high_confidence": {"type": "number", "minimum": 0.25, "maximum": 1.0},
        "critical_duration_ms": {"type": "integer", "minimum": 0, "maximum": 3600000}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["enabled", "profile_ref", "pre_duration_ms", "post_duration_ms", "snapshot", "clip", "retry_deadline_ms"],
      "properties": {
        "enabled": {"type": "boolean"},
        "profile_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "pre_duration_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
        "post_duration_ms": {"type": "integer", "minimum": 0, "maximum": 30000},
        "snapshot": {"type": "boolean"},
        "clip": {"type": "boolean"},
        "retry_deadline_ms": {"type": "integer", "minimum": 1000, "maximum": 86400000}
      }
    },
    "metadata": {
      "type": "object", "additionalProperties": false,
      "required": ["retention_profile_ref", "access_profile_ref", "aggregation_dimensions"],
      "properties": {
        "retention_profile_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "access_profile_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "aggregation_dimensions": {"type": "array", "maxItems": 8, "uniqueItems": true,
          "items": {"enum": ["class", "severity", "source", "zone", "hour", "day", "month"]}}
      }
    }
  }
}

