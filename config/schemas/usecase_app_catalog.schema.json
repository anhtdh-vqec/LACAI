{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vqec.local/schemas/usecase_app_catalog.schema.json",
  "title": "LACAI usecase application catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "revision", "applications"],
  "properties": {
    "schema_version": {"const": 1},
    "catalog_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "revision": {"type": "integer", "minimum": 1},
    "applications": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["catalog_code", "app_id", "display_name", "app_version", "published"],
        "properties": {
          "catalog_code": {"type": "string", "minLength": 1, "maxLength": 16},
          "app_id": {"type": "string", "minLength": 1, "maxLength": 128},
          "display_name": {"type": "string", "minLength": 1, "maxLength": 128},
          "app_version": {"type": "string", "minLength": 1, "maxLength": 64},
          "published": {"type": "boolean"}
        }
      }
    }
  }
}
