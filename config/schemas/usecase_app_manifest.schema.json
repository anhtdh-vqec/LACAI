{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vqec.local/schemas/usecase_app_manifest.schema.json",
  "title": "LACAI usecase application manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "app_id", "usecase_id", "app_version", "usecase_version",
    "release_sequence", "runtime_abi", "target_ids", "components", "features",
    "configuration", "requested_scopes", "resources", "data_policy", "supply_chain"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "app_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "maxLength": 128},
    "usecase_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$", "maxLength": 128},
    "app_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "usecase_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "release_sequence": {"type": "integer", "minimum": 1},
    "runtime_abi": {
      "type": "object", "additionalProperties": false,
      "required": ["major", "minor"],
      "properties": {"major": {"const": 1}, "minor": {"const": 0}}
    },
    "target_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 64}},
    "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/component"}},
    "features": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/feature"}},
    "configuration": {"$ref": "#/$defs/configuration"},
    "requested_scopes": {"$ref": "#/$defs/scopes"},
    "resources": {"$ref": "#/$defs/resources"},
    "data_policy": {"$ref": "#/$defs/dataPolicy"},
    "supply_chain": {"$ref": "#/$defs/supplyChain"},
    "rollback_predecessor": {"type": "string", "maxLength": 64}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "component_version", "component_type", "target_id", "artifact_sha256", "artifact_bytes", "semantic_contract_sha256", "required"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "component_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "component_type": {"enum": ["model", "labels", "ontology", "rules", "configuration"]},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 64},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "semantic_contract_sha256": {"$ref": "#/$defs/digest"},
        "required": {"type": "boolean"},
        "model_role": {"enum": ["primary", "secondary", "offline"]},
        "quality_receipt_ref": {"type": "string", "maxLength": 256}
      }
    },
    "feature": {
      "type": "object", "additionalProperties": false,
      "required": ["feature_id", "processor_contract", "configuration_schema_id"],
      "properties": {
        "feature_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "processor_contract": {"type": "string", "minLength": 1, "maxLength": 128},
        "configuration_schema_id": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_id", "schema_version", "defaults_sha256"],
      "properties": {
        "schema_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "schema_version": {"const": 1},
        "defaults_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "scopes": {
      "type": "object", "additionalProperties": false,
      "required": ["sources", "outputs", "queries", "evidence"],
      "properties": {
        "sources": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "outputs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "queries": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 32}},
        "evidence": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}}
      }
    },
    "resources": {
      "type": "object", "additionalProperties": false,
      "required": ["max_resident_bytes", "max_tensor_bytes", "max_active_incidents", "max_events_per_second"],
      "properties": {
        "max_resident_bytes": {"type": "integer", "minimum": 1},
        "max_tensor_bytes": {"type": "integer", "minimum": 1},
        "max_active_incidents": {"type": "integer", "minimum": 1, "maximum": 64},
        "max_events_per_second": {"type": "number", "exclusiveMinimum": 0, "maximum": 64}
      }
    },
    "dataPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["metadata_profile_ref", "uninstall_purges_data"],
      "properties": {
        "metadata_profile_ref": {"type": "string", "minLength": 1, "maxLength": 128},
        "uninstall_purges_data": {"const": false}
      }
    },
    "supplyChain": {
      "type": "object", "additionalProperties": false,
      "required": ["sbom_ref", "provenance_ref", "known_limits_ref"],
      "properties": {
        "sbom_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "provenance_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "known_limits_ref": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    }
  }
}
