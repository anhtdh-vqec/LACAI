{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YOLOv8 primary decoder package",
  "type": "object",
  "required": [
    "decoder_contract",
    "class_count",
    "confidence_threshold",
    "iou_threshold",
    "box_tensor",
    "score_tensor"
  ],
  "properties": {
    "kind": {
      "const": "yolov8"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 0
    },
    "model_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "decoder_contract": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "class_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "labels": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "string"
      }
    },
    "labels_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "confidence_threshold": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "iou_threshold": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "strides": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "grids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object"
      }
    },
    "anchors": {
      "type": "integer",
      "minimum": 1
    },
    "box_tensor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "score_tensor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "box_layout": {
      "type": "string"
    },
    "box_format": {
      "type": "string"
    },
    "box_space": {
      "type": "string"
    },
    "box_input_size": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "box_order": {
      "type": "string"
    },
    "score_semantics": {
      "type": "string"
    },
    "nms": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "not": {
    "required": [
      "labels",
      "labels_ref"
    ]
  }
}
