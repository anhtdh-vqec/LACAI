{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vqec.local/schemas/integration_contract_receipt.schema.json",
  "title": "LACAI producer conformance receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_id", "registry_revision", "receipt_id", "receipt_revision", "contract_id", "contract_version", "producer_team", "produced_at_utc", "expires_at_utc", "subject", "evidence", "consumer_disposition"],
  "properties": {
    "schema_version": {"const": 1},
    "registry_id": {"const": "lacai.integration_contract_registry"},
    "registry_revision": {"type": "integer", "minimum": 1},
    "receipt_id": {"$ref": "#/$defs/identifier"},
    "receipt_revision": {"type": "integer", "minimum": 1},
    "contract_id": {"type": "string", "pattern": "^C(0[1-9]|10)$"},
    "contract_version": {"const": 1},
    "producer_team": {"enum": ["bsp_fw", "ai_app", "ai_model"]},
    "produced_at_utc": {"$ref": "#/$defs/utc_timestamp"},
    "expires_at_utc": {"oneOf": [{"$ref": "#/$defs/utc_timestamp"}, {"type": "null"}]},
    "subject": {"$ref": "#/$defs/subject"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "consumer_disposition": {"$ref": "#/$defs/disposition"}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9_.-]+$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "utc_timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_id", "subject_version", "target_id", "artifact_digests"],
      "properties": {
        "subject_id": {"$ref": "#/$defs/identifier"},
        "subject_version": {"$ref": "#/$defs/identifier"},
        "target_id": {"$ref": "#/$defs/identifier"},
        "artifact_digests": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 64,
          "propertyNames": {"$ref": "#/$defs/identifier"},
          "additionalProperties": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment_reference", "command_reference", "case_report_digest", "case_ids", "deviations", "owner_signature_reference"],
      "properties": {
        "environment_reference": {"$ref": "#/$defs/identifier"},
        "command_reference": {"type": "string", "minLength": 1, "maxLength": 512},
        "case_report_digest": {"$ref": "#/$defs/sha256"},
        "case_ids": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^C(0[1-9]|10)_[a-z0-9_]+$", "maxLength": 128}},
        "deviations": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "owner_signature_reference": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "consumer_team", "decided_at_utc", "reason_code"],
      "properties": {
        "status": {"enum": ["pending", "accepted", "rejected", "accepted_with_deviation"]},
        "consumer_team": {"const": "ai_app"},
        "decided_at_utc": {"oneOf": [{"$ref": "#/$defs/utc_timestamp"}, {"type": "null"}]},
        "reason_code": {"oneOf": [{"type": "string", "pattern": "^[a-z][a-z0-9_]+$", "maxLength": 128}, {"type": "null"}]}
      }
    }
  }
}
