{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vqec.local/schemas/runtime_control_snapshot.schema.json",
  "title": "LACAI committed runtime control snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_revision", "inventory_revision", "entitlement_revision", "desired_revision", "associations"],
  "properties": {
    "schema_version": {"const": 1},
    "snapshot_revision": {"type": "integer", "minimum": 1},
    "inventory_revision": {"type": "integer", "minimum": 1},
    "entitlement_revision": {"type": "integer", "minimum": 1},
    "desired_revision": {"type": "integer", "minimum": 1},
    "associations": {"type": "array", "maxItems": 1024, "items": {"$ref": "#/$defs/association"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "association": {
      "type": "object", "additionalProperties": false,
      "required": ["app_id", "source_id", "app_version", "release_sequence", "installed", "entitled", "desired", "supported", "compatible", "admitted", "configuration_revision", "configuration_sha256", "configuration_schema_id", "configuration_payload", "output_scopes", "components"],
      "properties": {
        "app_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "source_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "app_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "release_sequence": {"type": "integer", "minimum": 1},
        "installed": {"type": "boolean"},
        "entitled": {"type": "boolean"},
        "desired": {"type": "boolean"},
        "supported": {"type": "boolean"},
        "compatible": {"type": "boolean"},
        "admitted": {"type": "boolean"},
        "configuration_revision": {"type": "integer", "minimum": 1},
        "configuration_sha256": {"$ref": "#/$defs/digest"},
        "configuration_schema_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "configuration_payload": {"type": "object"},
        "output_scopes": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "maxLength": 128}},
        "components": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/component"}},
        "reason_code": {"type": "string", "maxLength": 64},
        "entitlement_expires_utc_ns": {"type": "integer", "minimum": 1}
      }
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["component_id", "component_version", "component_type", "target_id", "artifact_sha256", "artifact_bytes", "semantic_contract_sha256", "model_role", "immutable_location"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "component_version": {"type": "string", "minLength": 1, "maxLength": 64},
        "component_type": {"enum": ["model", "labels", "ontology", "rules", "configuration"]},
        "target_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "artifact_sha256": {"$ref": "#/$defs/digest"},
        "artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "semantic_contract_sha256": {"$ref": "#/$defs/digest"},
        "model_role": {"enum": ["none", "primary", "secondary", "offline"]},
        "immutable_location": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^/"}
      }
    }
  }
}
